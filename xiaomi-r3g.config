# Xiaomi Mi Router 3G (original R3G, not v2); ImmortalWrt v25.12.2.
# The stock image already provides LuCI, block-mount, dnsmasq, firewall4,
# wpad-openssl, mt7603/mt76x2 Wi-Fi drivers and kmod-usb3.
# Kconfig selects transitive dependencies; do not carry over 24.10 kernel/libs.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3g=y
CONFIG_VERSION_NUMBER="25.12.2"
CONFIG_LUCI_LANG_zh_Hans=y

# Additional packages observed on the running 24.10.6 R3G.
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_usbids=y
CONFIG_PACKAGE_usbutils=y

# Phone USB tethering (the current uplink is usb0/RNDIS or CDC).
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-wdm=y

# WireGuard tunnel and LuCI configuration.
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# WeChatPush (prebuild replaces the release feed's LuCI package).
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y

# OAF v7: use the OAF feed, not the old luci-app-appfilter UI.
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y

# Web and scheduled access control, from the existing prebuild feed imports.
CONFIG_PACKAGE_luci-app-webrestriction=y
CONFIG_PACKAGE_luci-i18n-webrestriction-zh-cn=y
CONFIG_PACKAGE_luci-app-accesscontrol=y
CONFIG_PACKAGE_luci-i18n-accesscontrol-zh-cn=y
